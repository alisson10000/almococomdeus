# URL pública do site, sem barra no final. Usada em URLs canônicas e dados estruturados.
VITE_SITE_URL=

# API de contato local
PORT=3001
CORS_ORIGIN=http://localhost:5173

# SMTP para envio do Fale Conosco
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=usuario@exemplo.com
SMTP_PASS=sua_senha_ou_app_password
CONTACT_TO_EMAIL=destino@exemplo.com
CONTACT_FROM_EMAIL=usuario@exemplo.com
